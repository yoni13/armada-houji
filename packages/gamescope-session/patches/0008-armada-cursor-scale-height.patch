Subject: [PATCH] add cursor scale height option

ARMADA_GAMESCOPE_CURSOR_SCALE_HEIGHT (device profile) or CURSOR_SCALE_HEIGHT
(user configuration) passes --cursor-scale-height to gamescope, which otherwise
draws a game's cursor at its native size. A 24 px X cursor is about 1.3 mm tall
on a 460 ppi phone panel. Only whole numbers are accepted.

---
 usr/share/gamescope-session-plus/gamescope-session-plus | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

--- a/usr/share/gamescope-session-plus/gamescope-session-plus
+++ b/usr/share/gamescope-session-plus/gamescope-session-plus
@@ -121,6 +121,10 @@
 if [ "${ARMADA_GAMESCOPE_USE_ROTATION_SHADER:-0}" = "1" ]; then
 	FORCE_COMPOSITION_ROTATION=1
 fi
+case "${ARMADA_GAMESCOPE_CURSOR_SCALE_HEIGHT:-}" in
+	''|*[!0-9]*) ;;
+	*) CURSOR_SCALE_HEIGHT="$ARMADA_GAMESCOPE_CURSOR_SCALE_HEIGHT" ;;
+esac
 
 # Source client app specific configuration files
 set -a
@@ -181,6 +185,17 @@
 		CURSOR="--cursor ${CURSOR_FILE}"
 	fi
 
+	# Scale the cursor against the output height on high-density panels.
+	CURSOR_SCALE_HEIGHT_OPTION=""
+	case "${CURSOR_SCALE_HEIGHT:-}" in
+		''|*[!0-9]*) ;;
+		*)
+			if gamescope_has_option "--cursor-scale-height"; then
+				CURSOR_SCALE_HEIGHT_OPTION="--cursor-scale-height $CURSOR_SCALE_HEIGHT"
+			fi
+			;;
+	esac
+
 	RESOLUTION=""
 	if [ -n "$SCREEN_WIDTH" ] && [ -n "$SCREEN_HEIGHT" ]; then
 		RESOLUTION="-W $SCREEN_WIDTH -H $SCREEN_HEIGHT"
@@ -281,6 +296,7 @@
 
 	GAMESCOPECMD="$(get_gamescope_binary) \
 		$CURSOR \
+		$CURSOR_SCALE_HEIGHT_OPTION \
 		$RESOLUTION \
 		$INTERNAL_RESOLUTION \
 		$ORIENTATION_OPTION \
