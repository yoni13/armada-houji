From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Armada
Subject: [PATCH] Battery: prefer the firmware percentage

Show the battery's capacity, the percentage UPower and Steam show, when
the battery reports one. charge_now / charge_full is the raw cell charge;
on Xiaomi 14 (houji) it read 70% while the firmware and Steam showed 83%.

---
diff --git a/src/battery.cpp b/src/battery.cpp
index 7104f9c..70cb467 100644
--- a/src/battery.cpp
+++ b/src/battery.cpp
@@ -51,7 +51,19 @@ float BatteryStats::getPercent()
         string energy_full = syspath + "/energy_full";
         string capacity = syspath + "/capacity";
 
-        if (fs::exists(charge_now)) {
+        // Prefer the firmware's percentage, which the system battery indicator
+        // (UPower, Steam) shows. charge_now / charge_full is the raw cell charge
+        // and can differ from it by more than ten points.
+        if (fs::exists(capacity)) {
+            std::ifstream input(capacity);
+            std::string line;
+            if(std::getline(input, line)) {
+                charge_n += stof(line) / 100;
+                charge_f += 1;
+            }
+        }
+
+        else if (fs::exists(charge_now)) {
             std::ifstream input(charge_now);
             std::string line;
             if(std::getline(input, line)) {
