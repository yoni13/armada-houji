+/* ARRAY_STRUCT elements retain their own TLV headers. Parse the inner
+ * header before accessing the hardware-mode ID and MHz cutoff fields.
+ */
+static int ath12k_wmi_tlv_dbs_or_sbs_caps(struct ath12k_base *ab, u16 tag,
+                                       u16 len, const void *ptr, void *data)
+{
+	const struct ath12k_wmi_dbs_or_sbs_cap_params *caps = ptr;
+
+	if (tag != WMI_TAG_DBS_OR_SBS_CAP_EXT)
+		return 0;
+
+	if (len < sizeof(*caps))
+		return -EINVAL;
+
+	if (le32_to_cpu(caps->hw_mode_id) != ab->wmi_ab.preferred_hw_mode)
+		return 0;
+
+	ab->wmi_ab.sbs_lower_band_end_freq =
+		le32_to_cpu(caps->sbs_lower_band_end_freq);
+
+	ath12k_dbg(ab, ATH12K_DBG_WMI, "SBS hw mode %u cutoff %u MHz\n",
+		   le32_to_cpu(caps->hw_mode_id),
+		   ab->wmi_ab.sbs_lower_band_end_freq);
+	return 0;
+}
