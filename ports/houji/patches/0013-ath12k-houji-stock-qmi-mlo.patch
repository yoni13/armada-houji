--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -2354,6 +2354,33 @@
 	ret = ath12k_host_cap_parse_mlo(ab, &req);
 	if (ret < 0)
 		goto out;
+	/* The pinned Xiaomi Kiwi v2 firmware expects the stock CNSS topology.
+	 * Stock CNSS advertises this single-chip topology before WMI INIT.
+	 * The mobile firmware allocates max_mlo_peer - 2 entries even when
+	 * the host does not expose MLO through mac80211.
+	 */
+	if (ab->hw_rev == ATH12K_HW_WCN7850_HW20 &&
+	    of_machine_is_compatible("xiaomi,houji")) {
+		req.mlo_capable_valid = 1;
+		req.mlo_capable = 1;
+		req.mlo_chip_id_valid = 1;
+		req.mlo_chip_id = 0;
+		req.mlo_group_id_valid = 1;
+		req.mlo_group_id = 0;
+		req.max_mlo_peer_valid = 1;
+		req.max_mlo_peer = 32;
+		req.mlo_num_chips_valid = 1;
+		req.mlo_num_chips = 1;
+		req.mlo_chip_info_valid = 1;
+		memset(req.mlo_chip_info, 0, sizeof(req.mlo_chip_info));
+		req.mlo_chip_info[0].chip_id = 0;
+		req.mlo_chip_info[0].num_local_links = 2;
+		req.mlo_chip_info[0].hw_link_id[0] = 0;
+		req.mlo_chip_info[0].hw_link_id[1] = 1;
+		req.mlo_chip_info[0].valid_mlo_link_id[0] = 1;
+		req.mlo_chip_info[0].valid_mlo_link_id[1] = 1;
+	}
+
 
 	ret = qmi_txn_init(&ab->qmi.handle, &txn,
 			   qmi_wlanfw_host_cap_resp_msg_v01_ei, &resp);
