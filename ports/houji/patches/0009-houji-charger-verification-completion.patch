+/* HyperOS always sends VERIFY_PROCESS=0 on its failure/abort path before
+ * reporting the authentication result. This ends negotiation, not authenticates
+ * the adapter. Deliberately expose neither an auth result setter nor a start.
+ */
+static ssize_t houji_charger_state_show(struct device *dev,
+					struct device_attribute *attr,
+					char *buf)
+{
+	struct qcom_battmgr *b = dev_get_drvdata(dev);
+	const u32 props[] = { 20, 32, 5 };
+	const char *names[] = { "verify_process", "pd_verified",
+				"battery_authentic" };
+	int i, ret, count = 0;
+	if (!b->service_up)
+		return -EAGAIN;
+	mutex_lock(&b->lock);
+	for (i = 0; i < ARRAY_SIZE(props); i++) {
+		ret = qcom_battmgr_request_property(b, 0x50, props[i], 0);
+		if (ret) {
+			count = ret;
+			break;
+		}
+		count += sysfs_emit_at(buf, count, "%s=%u\n", names[i],
+				       b->houji_xm_value);
+	}
+	mutex_unlock(&b->lock);
+	return count;
+}
+static DEVICE_ATTR_RO(houji_charger_state);
+
+static ssize_t houji_charger_verify_idle_store(struct device *dev,
+					       struct device_attribute *attr,
+					       const char *buf, size_t count)
+{
+	struct qcom_battmgr *b = dev_get_drvdata(dev);
+	union power_supply_propval val = { .intval = 500000 };
+	bool value;
+	int ret;
+	if (kstrtobool(buf, &value) || value)
+		return -EINVAL;
+	/* Install a conservative FCC cap, with PD/temperature guards, first. */
+	ret = houji_bat_set_property(
+		b->bat_psy, POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT, &val);
+	if (ret)
+		return ret;
+	mutex_lock(&b->lock);
+	ret = qcom_battmgr_request_property(b, 0x51, 20, 0);
+	mutex_unlock(&b->lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(houji_charger_verify_idle);
