+/* Stock HyperOS thermal_fcc_override writes BAT_SET property 12.
+ * This bring-up interface permits at most 1 A battery current. Firmware
+ * adapter, authentication, JEITA and other thermal votes remain in place.
+ */
+static int houji_bat_set_property(struct power_supply *psy,
+				  enum power_supply_property psp,
+				  const union power_supply_propval *val)
+{
+	struct qcom_battmgr *b = power_supply_get_drvdata(psy);
+	int ret;
+	if (b->variant != QCOM_BATTMGR_XIAOMI_HOUJI ||
+	    psp != POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT)
+		return -EOPNOTSUPP;
+	if (val->intval < 0 || val->intval > 1000000)
+		return -ERANGE;
+	if (!b->service_up)
+		return -EAGAIN;
+	mutex_lock(&b->lock);
+	/* A positive request requires a detected USB-PD supply and sane battery
+  * temperature. Zero remains available for reducing the host vote. */
+	if (val->intval) {
+		ret = qcom_battmgr_request_property(b, BATTMGR_USB_PROPERTY_GET,
+						    USB_ONLINE, 0);
+		if (ret)
+			goto out;
+		if (!b->usb.online) {
+			ret = -ENODEV;
+			goto out;
+		}
+		ret = qcom_battmgr_request_property(b, BATTMGR_USB_PROPERTY_GET,
+						    USB_ADAP_TYPE, 0);
+		if (ret)
+			goto out;
+		if (b->usb.usb_type != POWER_SUPPLY_USB_TYPE_PD) {
+			ret = -EOPNOTSUPP;
+			goto out;
+		}
+		ret = qcom_battmgr_request_property(b, BATTMGR_BAT_PROPERTY_GET,
+						    BATT_TEMP + 1, 0);
+		if (ret)
+			goto out;
+		if (b->status.temperature < 100 ||
+		    b->status.temperature > 400) {
+			ret = -ERANGE;
+			goto out;
+		}
+	}
+	ret = qcom_battmgr_request_property(b, BATTMGR_BAT_PROPERTY_SET,
+					    HOUJI_BATT_FCC, val->intval);
+	if (!ret)
+		ret = qcom_battmgr_request_property(b, BATTMGR_BAT_PROPERTY_GET,
+						    HOUJI_BATT_FCC, 0);
+out:
+	mutex_unlock(&b->lock);
+	if (!ret)
+		power_supply_changed(psy);
+	return ret;
+}
