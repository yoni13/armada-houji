+	int ret;
+	u32 value;
+	if (!b->service_up)
+		return -EAGAIN;
+	mutex_lock(&b->lock);
+	ret = qcom_battmgr_request_property(b, BATTMGR_BAT_PROPERTY_GET,
+					    BATT_CHG_CTRL_LIM, 0);
+	value = b->houji_thermal_level;
+	mutex_unlock(&b->lock);
+	return ret ? ret : sysfs_emit(buf, "%u\n", value);
+}
