+static int houji_charging_source_locked(struct qcom_battmgr *b)
+{
+	int ret;
+	ret = qcom_battmgr_request_property(b, BATTMGR_USB_PROPERTY_GET, USB_ONLINE, 0);
+	if (ret)
+		return ret;
+	if (b->usb.online) {
+		ret = qcom_battmgr_request_property(b, BATTMGR_USB_PROPERTY_GET, USB_ADAP_TYPE, 0);
+		if (ret)
+			return ret;
+		if (b->usb.usb_type == POWER_SUPPLY_USB_TYPE_PD ||
+		    b->usb.usb_type == POWER_SUPPLY_USB_TYPE_PD_PPS)
+			return 1;
+	}
+	ret = qcom_battmgr_request_property(b, BATTMGR_WLS_PROPERTY_GET, WLS_ONLINE, 0);
+	if (ret)
+		return ret;
+	return b->wireless.online ? 2 : -ENODEV;
+}
