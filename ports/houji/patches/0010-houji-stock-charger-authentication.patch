+static ssize_t request_vdm_cmd_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct qcom_battmgr *b = dev_get_drvdata(dev);
+	u32 state;
+	int ret;
+	if (!b->service_up)
+		return -EAGAIN;
+	mutex_lock(&b->lock);
+	ret = qcom_battmgr_request_property(b, 0x50, 34, 0);
+	if (ret)
+		goto out;
+	state = b->houji_xm_value;
+	if (state >= 1 && state <= 3) {
+		ret = qcom_battmgr_request_property(b, 0x50, 20 + state, 0);
+		if (!ret)
+			ret = sysfs_emit(buf, "%u,%u\n", state, b->houji_xm_value);
+	} else if (state == 5) {
+		ret = houji_xm_extended(b, 0x50, 25, NULL, 16);
+		if (!ret)
+			ret = sysfs_emit(buf, "5,%08x%08x%08x%08x\n",
+				get_unaligned_le32(b->houji_xm_payload),
+				get_unaligned_le32(b->houji_xm_payload + 4),
+				get_unaligned_le32(b->houji_xm_payload + 8),
+				get_unaligned_le32(b->houji_xm_payload + 12));
+	} else if (state <= 9) {
+		ret = sysfs_emit(buf, "%u,Null\n", state);
+	} else {
+		ret = -EPROTO;
+	}
+out:
+	mutex_unlock(&b->lock);
+	return ret;
+}
