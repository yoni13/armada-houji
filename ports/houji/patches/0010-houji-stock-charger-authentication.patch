+static ssize_t request_vdm_cmd_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct qcom_battmgr *b = dev_get_drvdata(dev);
+	size_t size = houji_text_length(buf, count);
+	u8 payload[16] = {};
+	unsigned int cmd, i;
+	u32 value = 0;
+	int ret;
+	if (size < 3 || buf[0] < '1' || buf[0] > '8' || buf[1] != ',')
+		return -EINVAL;
+	cmd = buf[0] - '0';
+	if (cmd <= 3) {
+		if (size != 6 || memcmp(buf + 2, "null", 4))
+			return -EINVAL;
+	} else if (cmd == 6 || cmd == 7) {
+		if (size != 10 || hex2bin(payload, buf + 2, 4))
+			return -EINVAL;
+		value = get_unaligned_le32(payload);
+		if (value > 1)
+			return -EINVAL;
+	} else {
+		if (size != 34 || hex2bin(payload, buf + 2, 16))
+			return -EINVAL;
+		/* Match Xiaomi's StringToHex followed by swab32 for each VDO. */
+		for (i = 0; i < 16; i += 4)
+			put_unaligned_le32(get_unaligned_be32(payload + i), payload + i);
+	}
+	if (!b->service_up)
+		return -EAGAIN;
+	mutex_lock(&b->lock);
+	if (cmd == 4 || cmd == 5 || cmd == 8)
+		ret = houji_xm_extended(b, 0x51, 20 + cmd, payload, 16);
+	else
+		ret = qcom_battmgr_request_property(b, 0x51, 20 + cmd, value);
+	mutex_unlock(&b->lock);
+	memzero_explicit(payload, sizeof(payload));
+	return ret ? ret : count;
+}
