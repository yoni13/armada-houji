+/* Staging ceiling for measured bring-up. Raising this ceiling does not itself
+ * vote for more current. Every higher vote still needs live authentication,
+ * fresh board reporting and the ten-second renewal below. Stock's highest
+ * normal-mode FCC vote is 15.6 A; never accept the unrestricted -1 sentinel.
+ */
+static unsigned int houji_max_fcc_ua = 1000000;
+static int houji_set_fcc_cap(const char *val, const struct kernel_param *kp)
+{
+	unsigned int value;
+	int ret = kstrtouint(val, 10, &value);
+	if (ret)
+		return ret;
+	if (value < 1000000 || value > 15600000)
+		return -ERANGE;
+	WRITE_ONCE(*(unsigned int *)kp->arg, value);
+	return 0;
+}
