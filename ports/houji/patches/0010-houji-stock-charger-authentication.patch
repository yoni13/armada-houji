+static ssize_t verify_digest_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct qcom_battmgr *b = dev_get_drvdata(dev);
+	int ret;
+	if (!b->service_up)
+		return -EAGAIN;
+	mutex_lock(&b->lock);
+	ret = houji_xm_extended(b, 0x50, 1, NULL, 32);
+	if (!ret) {
+		bin2hex(buf, b->houji_xm_payload, 32);
+		buf[64] = '\n';
+		ret = 65;
+	}
+	mutex_unlock(&b->lock);
+	return ret;
+}
+
+static size_t houji_text_length(const char *buf, size_t count)
+{
+	/* Vendor writes include either one NUL or a newline. Reject other tails. */
+	if (count && (buf[count - 1] == '\n' || !buf[count - 1]))
+		count--;
+	return count;
+}
+
+static ssize_t verify_digest_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct qcom_battmgr *b = dev_get_drvdata(dev);
+	u8 challenge[32];
+	int ret;
+	if (houji_text_length(buf, count) != 64 || hex2bin(challenge, buf, 32))
+		return -EINVAL;
+	if (!b->service_up)
+		return -EAGAIN;
+	mutex_lock(&b->lock);
+	ret = houji_xm_extended(b, 0x51, 1, challenge, 32);
+	mutex_unlock(&b->lock);
+	memzero_explicit(challenge, sizeof(challenge));
+	return ret ? ret : count;
+}
+static DEVICE_ATTR(verify_digest, 0600, verify_digest_show, verify_digest_store);
