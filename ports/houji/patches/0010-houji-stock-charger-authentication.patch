+struct houji_xm_attribute {
+	struct device_attribute attr;
+	u32 property;
+	bool hex;
+};
+
+static ssize_t houji_xm_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct qcom_battmgr *b = dev_get_drvdata(dev);
+	struct houji_xm_attribute *a = container_of(attr, struct houji_xm_attribute, attr);
+	int ret;
+	u32 value;
+	if (!b->service_up)
+		return -EAGAIN;
+	mutex_lock(&b->lock);
+	ret = qcom_battmgr_request_property(b, 0x50, a->property, 0);
+	value = b->houji_xm_value;
+	mutex_unlock(&b->lock);
+	if (ret)
+		return ret;
+	return sysfs_emit(buf, a->hex ?
+		(a->property == 31 ? "%04x\n" : "%08x\n") : "%u\n", value);
+}
+
+static ssize_t houji_xm_bool_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct qcom_battmgr *b = dev_get_drvdata(dev);
+	struct houji_xm_attribute *a = container_of(attr, struct houji_xm_attribute, attr);
+	bool value;
+	int ret;
+	if (kstrtobool(buf, &value))
+		return -EINVAL;
+	if (!b->service_up)
+		return -EAGAIN;
+	mutex_lock(&b->lock);
+	ret = qcom_battmgr_request_property(b, 0x51, a->property, value);
+	mutex_unlock(&b->lock);
+	return ret ? ret : count;
+}
+
+static ssize_t houji_board_temp_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct qcom_battmgr *b = dev_get_drvdata(dev);
+	u32 value;
+	int ret;
+	/* Stock mi_thermal_interface reports the virtual skin sensor in deci-C. */
+	if (kstrtou32(buf, 10, &value) || value > 800)
+		return -EINVAL;
+	if (!b->service_up)
+		return -EAGAIN;
+	mutex_lock(&b->lock);
+	ret = qcom_battmgr_request_property(b, 0x51, 10, value);
+	if (!ret) {
+		b->houji_board_temp = value;
+		b->houji_board_updated = jiffies;
+		b->houji_board_valid = true;
+	}
+	mutex_unlock(&b->lock);
+	return ret ? ret : count;
+}
