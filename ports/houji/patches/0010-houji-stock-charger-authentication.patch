+/* Houji HyperOS batterysecret ABI, mapped to the existing serialized client.
+ * Authentication stays in the hash-pinned vendor agent. These are firmware
+ * properties, not direct PMIC register accesses or replacements for JEITA.
+ */
+static int houji_xm_extended(struct qcom_battmgr *b, u32 opcode,
+			     u32 property, const void *payload, size_t size)
+{
+	struct {
+		struct pmic_glink_hdr hdr;
+		__le32 property;
+		u8 payload[32];
+		__le32 slave;
+	} req = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(opcode),
+		.property = cpu_to_le32(property),
+	};
+	if (size != 16 && size != 32)
+		return -EINVAL;
+	if (payload)
+		memcpy(req.payload, payload, size);
+	return qcom_battmgr_request(b, &req, size == 16 ? 32 : 52);
+}
