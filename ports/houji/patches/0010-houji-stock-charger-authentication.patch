+static ssize_t wired_thermal_level_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct qcom_battmgr *b = dev_get_drvdata(dev);
+	u32 value;
+	int ret;
+	if (kstrtou32(buf, 10, &value) || value > 15)
+		return -EINVAL;
+	if (!b->service_up)
+		return -EAGAIN;
+	mutex_lock(&b->lock);
+	ret = qcom_battmgr_request_property(b, BATTMGR_BAT_PROPERTY_SET,
+					    BATT_CHG_CTRL_LIM, value);
+	mutex_unlock(&b->lock);
+	return ret ? ret : count;
