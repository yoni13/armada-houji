 /* Stock HyperOS thermal_fcc_override writes BAT_SET property 12.
- * This bring-up interface permits at most 1 A battery current. Firmware
+ * The bring-up ceiling defaults to 1 A and can be staged up to 15.6 A. Firmware
  * adapter, authentication, JEITA and other thermal votes remain in place.
  */
+/* A higher host FCC vote is a lease. If its userspace owner disappears, do
+ * not leave that vote in ADSP indefinitely. Retain the conservative 500 mA
+ * baseline and the independent firmware thermal/authentication limits.
+ */
+static void houji_fcc_watchdog(struct work_struct *work)
+{
+	struct qcom_battmgr *b = container_of(to_delayed_work(work),
+					    struct qcom_battmgr, houji_fcc_work);
+	int ret;
+	mutex_lock(&b->lock);
+	if (READ_ONCE(b->houji_fcc_stopping) || b->houji_fcc_vote <= 500000)
+		goto out;
+	if (time_before(jiffies, b->houji_fcc_deadline)) {
+		mod_delayed_work(system_wq, &b->houji_fcc_work,
+				 b->houji_fcc_deadline - jiffies);
+		goto out;
+	}
+	if (!b->service_up) {
+		mod_delayed_work(system_wq, &b->houji_fcc_work, HZ);
+		goto out;
+	}
+	ret = qcom_battmgr_request_property(b, BATTMGR_BAT_PROPERTY_SET,
+					    HOUJI_BATT_FCC, 500000);
+	if (ret) {
+		dev_warn_ratelimited(b->dev, "expired FCC lease: fallback failed: %d\n", ret);
+		mod_delayed_work(system_wq, &b->houji_fcc_work, HZ);
+	} else {
+		b->houji_fcc = 500000;
+		b->houji_fcc_vote = 500000;
+		dev_info(b->dev, "host FCC lease expired; reduced to 500 mA\n");
+	}
+out:
+	mutex_unlock(&b->lock);
+}
+
+static void houji_fcc_stop(void *data)
+{
+	struct qcom_battmgr *b = data;
+	WRITE_ONCE(b->houji_fcc_stopping, true);
+	cancel_delayed_work_sync(&b->houji_fcc_work);
+	mutex_lock(&b->lock);
+	if (b->service_up && b->houji_fcc_vote > 500000)
+		qcom_battmgr_request_property(b, BATTMGR_BAT_PROPERTY_SET,
+					     HOUJI_BATT_FCC, 500000);
+	mutex_unlock(&b->lock);
+}
+/* Caller holds the serialized GLINK lock. Wired PD takes precedence when both
