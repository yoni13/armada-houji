+static ssize_t wireless_thermal_level_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct qcom_battmgr *b = dev_get_drvdata(dev);
+	struct houji_xm_attribute *a = container_of(attr, struct houji_xm_attribute, attr);
+	u32 value;
+	int ret;
+	if (kstrtou32(buf, 10, &value) || value > 15)
+		return -EINVAL;
+	if (!b->service_up)
+		return -EAGAIN;
+	mutex_lock(&b->lock);
+	ret = qcom_battmgr_request_property(b, BATTMGR_WLS_PROPERTY_GET,
+					    WLS_ONLINE, 0);
+	if (!ret && !b->wireless.online)
+		ret = -ENODEV;
+	if (!ret)
+		ret = qcom_battmgr_request_property(b, 0x51, a->property, value);
+	mutex_unlock(&b->lock);
+	return ret ? ret : count;
+}
