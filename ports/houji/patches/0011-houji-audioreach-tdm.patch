+static int q6tdm_set_tdm_slot(struct snd_soc_dai *dai, unsigned int tx_mask,
+			    unsigned int rx_mask, int slots, int slot_width)
+{
+	struct q6apm_lpass_dai_data *data = dev_get_drvdata(dai->dev);
+	struct audioreach_module_config *cfg = &data->module_config[dai->id];
+	u32 mask = dai->id & 1 ? tx_mask : rx_mask;
+
+	if (slots < 1 || slots > 32 ||
+	    (slot_width != 16 && slot_width != 32) || !mask ||
+	    (slots < 32 && mask >> slots))
+		return -EINVAL;
+
+	cfg->tdm_slots = slots;
+	cfg->tdm_slot_width = slot_width;
+	cfg->tdm_slot_mask = mask;
+	return 0;
