+	param->module_instance_id = module->instance_id;
+	param->param_id = PARAM_ID_TDM_LANE_CFG;
+	param->param_size = 4;
+	lane_cfg = p + APM_MODULE_PARAM_DATA_SIZE;
+	lane_cfg[0] = BIT(module->sd_line_idx);
