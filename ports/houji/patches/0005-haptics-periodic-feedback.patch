+/* The FF playback callback runs under input_dev.event_lock. Do register and
+ * regulator operations in workqueue context, where they are allowed to sleep.
+ */
+static void haptics_play_work(struct work_struct *work)
+{
+	struct haptics_chip *chip = container_of(work, struct haptics_chip, play_work);
+	int rc = 0;
+
+	cancel_delayed_work_sync(&chip->stop_work);
+	mutex_lock(&chip->play.lock);
+	dev_dbg(chip->dev, "FF playback request %d\n",
+		atomic_read(&chip->play_requested));
+	if (!atomic_read(&chip->play_requested)) {
+		rc = haptics_enable_play(chip, false);
+		if (!rc)
+			rc = haptics_enable_hpwr_vreg(chip, false);
+		goto out;
+	}
+	if (!chip->chip_effect_loaded)
+		goto out;
+
+	/* The duration timer disables HPWR, so replay must enable it again. */
+	rc = haptics_enable_hpwr_vreg(chip, true);
+	if (rc)
+		goto out;
+	rc = haptics_wait_hboost_ready(chip);
+	if (rc)
+		goto stop;
+	if (chip->config.measure_lra_impedance && chip->visense_enabled)
+		chip->pattern_start_time = ktime_get_boottime();
+	rc = haptics_enable_play(chip, true);
+	if (rc)
+		goto stop;
+	if (chip->play.pattern_src == DIRECT_PLAY)
+		mod_delayed_work(system_wq, &chip->stop_work,
+			msecs_to_jiffies(chip->constant_length_ms));
+	goto out;
+stop:
+	haptics_enable_play(chip, false);
+	haptics_enable_hpwr_vreg(chip, false);
+out:
+	mutex_unlock(&chip->play.lock);
+	if (rc)
+		dev_err(chip->dev, "FF playback failed: %d\n", rc);
+}
