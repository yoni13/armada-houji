+static struct xiaomi_n3 *to_n3(struct drm_panel *panel)
+{
+	return container_of(panel, struct xiaomi_n3, panel);
+}
+
+/* Xiaomi ABL stores twelve page-0x13 gamma register payloads in SMEM 499.
+ * Each channel has three 16-byte payloads and a final 2-byte payload, with
+ * a register byte before each: 54 bytes per channel, 162 bytes in total.
+ * Check the complete layout and reject blank data before overriding defaults.
+ */
+static const u8 *n3_bootloader_gamma(struct device *dev)
+{
+	const u8 *gamma;
+	size_t size;
+	unsigned int channel, reg, off;
+	bool nonzero = false;
+
+	gamma = qcom_smem_get(QCOM_SMEM_HOST_ANY, 499, &size);
+	if (IS_ERR(gamma)) {
+		dev_info(dev, "Bootloader gamma unavailable (%ld); using defaults\n",
+			 PTR_ERR(gamma));
+		return NULL;
+	}
+	if (size < 162)
+		goto invalid;
+	for (channel = 0; channel < 3; channel++) {
+		for (reg = 0; reg < 4; reg++) {
+			off = channel * 54 + reg * 17;
+			if (gamma[off] != 0xb0 + channel * 4 + reg)
+				goto invalid;
+		}
+		/* The last control point must be populated for every color. */
+		off = channel * 54 + 52;
+		if ((!gamma[off] && !gamma[off + 1]) ||
+		    (gamma[off] == 0xff && gamma[off + 1] == 0xff))
+			goto invalid;
+		nonzero |= gamma[off] || gamma[off + 1];
+	}
+	if (!nonzero)
+		goto invalid;
+	dev_info(dev, "Using bootloader per-panel gamma (SMEM 499, %zu bytes)\n", size);
+	return gamma;
+invalid:
+	dev_warn(dev, "Invalid bootloader gamma layout (%zu bytes); using defaults\n", size);
+	return NULL;
+}
+
+static int n3_on(struct xiaomi_n3 *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct drm_dsc_picture_parameter_set pps;
+	u8 pps_cmd[95] = { 0x70 };
+	const u8 *gamma = n3_bootloader_gamma(&dsi->dev);
+	u8 page = 0;
+	unsigned int i;
+	ssize_t ret;
+
+	/* MSM fills in RC parameters before preparing the panel. Use that same
+	 * PPS for the panel decoder, including its vendor 0x70 register write.
+	 * Otherwise a hard-coded vendor PPS can differ from the DPU encoder.
+	 */
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+	memcpy(pps_cmd + 1, &pps, sizeof(pps_cmd) - 1);
+
+	for (i = 0; i < ARRAY_SIZE(n3_on_cmds); i++) {
+		const struct n3_cmd *cmd = &n3_on_cmds[i];
+		const u8 *data = cmd->data;
+
+		if (cmd->len == 3 && data[0] == 0xf0 && data[1] == 0xaa)
+			page = data[2];
+		if (gamma && page == 0x13 && data[0] >= 0xb0 && data[0] <= 0xbb) {
+			unsigned int reg = data[0] - 0xb0;
+			unsigned int len = reg % 4 == 3 ? 3 : 17;
+
+			if (cmd->len == len)
+				data = gamma + (reg / 4) * 54 + (reg % 4) * 17;
+		}
+
+		if (cmd->len == sizeof(pps_cmd) && data[0] == 0x70)
+			data = pps_cmd;
+
+		/* Configure DSC and keep brightness zero before leaving sleep. */
+		if (cmd->len == 1 && data[0] == 0x11) {
+			ret = mipi_dsi_picture_parameter_set(dsi, &pps);
+			if (ret < 0)
+				return ret;
+			ret = mipi_dsi_compression_mode(dsi, true);
+			if (ret < 0)
+				return ret;
+			ret = mipi_dsi_dcs_set_display_brightness_large(dsi, 0);
+			if (ret < 0)
+				return ret;
+		}
+
+		ret = mipi_dsi_dcs_write_buffer(dsi, data, cmd->len);
+		if (ret < 0) {
+			dev_err(&dsi->dev, "N3 init command %u (0x%02x) failed: %zd\n",
+				i, data[0], ret);
+			return ret;
+		}
+		if (cmd->delay_ms)
+			msleep(cmd->delay_ms);
+	}
+
+	return 0;
+}
+
+static void n3_power_off(struct xiaomi_n3 *ctx)
+{
+	int i, ret;
+
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	/* Reverse vendor power order: VDDD, VCI, VDDIO. */
+	for (i = ARRAY_SIZE(ctx->supplies) - 1; i >= 0; i--) {
+		usleep_range(1000, 2000);
+		ret = regulator_disable(ctx->supplies[i].consumer);
+		if (ret)
+			dev_warn(&ctx->dsi->dev, "Failed to disable %s: %d\n",
+				 ctx->supplies[i].supply, ret);
+	}
+	ctx->powered = false;
+}
+
+static int n3_prepare(struct drm_panel *panel)
+{
+	struct xiaomi_n3 *ctx = to_n3(panel);
+	unsigned long flags;
+	int i, ret;
+
+	mutex_lock(&ctx->lock);
+	for (i = 0; i < ARRAY_SIZE(ctx->supplies); i++) {
+		ret = regulator_enable(ctx->supplies[i].consumer);
+		if (ret)
+			goto disable_supplies;
+		/* Vendor post-on delays: VDDIO 2 ms, VCI 1 ms, VDDD 1 ms. */
+		usleep_range(i ? 1000 : 2000, i ? 2000 : 3000);
+	}
+
+	/* Active-low reset: physical low for 15 ms, high for 20 ms. */
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	usleep_range(15000, 16000);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	msleep(20);
+
+	flags = ctx->dsi->mode_flags;
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = n3_on(ctx);
+	ctx->dsi->mode_flags = flags;
+	if (ret) {
+		n3_power_off(ctx);
+		goto unlock;
+	}
+	ctx->powered = true;
+	dev_info(&ctx->dsi->dev, "N3 initialized: 1200x2670 120 Hz, DSC 10 bpc / 8 bpp\n");
+	goto unlock;
+
+disable_supplies:
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	while (--i >= 0) {
+		usleep_range(1000, 2000);
+		regulator_disable(ctx->supplies[i].consumer);
+	}
+unlock:
+	mutex_unlock(&ctx->lock);
+	return ret;
+}
+
+static int n3_disable(struct drm_panel *panel)
+{
+	struct xiaomi_n3 *ctx = to_n3(panel);
+	unsigned long flags;
+	int ret;
+
+	mutex_lock(&ctx->lock);
+	flags = ctx->dsi->mode_flags;
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_off(ctx->dsi);
+	if (ret)
+		dev_warn(&ctx->dsi->dev, "Display off failed: %d\n", ret);
+	usleep_range(10000, 11000);
+	ctx->dsi->mode_flags = flags;
+	mutex_unlock(&ctx->lock);
+	return 0;
+}
+
+static int n3_unprepare(struct drm_panel *panel)
+{
+	struct xiaomi_n3 *ctx = to_n3(panel);
+	unsigned long flags;
+	int ret;
+
+	mutex_lock(&ctx->lock);
+	flags = ctx->dsi->mode_flags;
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_enter_sleep_mode(ctx->dsi);
+	if (ret)
+		dev_warn(&ctx->dsi->dev, "Enter sleep failed: %d\n", ret);
+	/* Honor the vendor off delay even when the DCS transfer fails. */
+	msleep(120);
+	ctx->dsi->mode_flags = flags;
+	n3_power_off(ctx);
+	mutex_unlock(&ctx->lock);
+	return 0;
+}
+
+static const struct drm_display_mode n3_mode = {
+	.clock = (1200 + 16 + 16 + 32) * (2670 + 45 + 8 + 37) * 120 / 1000,
+	.hdisplay = 1200,
+	.hsync_start = 1200 + 16,
+	.hsync_end = 1200 + 16 + 16,
+	.htotal = 1200 + 16 + 16 + 32,
+	.vdisplay = 2670,
+	.vsync_start = 2670 + 45,
+	.vsync_end = 2670 + 45 + 8,
+	.vtotal = 2670 + 45 + 8 + 37,
+	.width_mm = 66,
+	.height_mm = 147,
+};
+
+static int n3_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &n3_mode);
+	if (!mode)
+		return -ENOMEM;
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+	connector->display_info.width_mm = n3_mode.width_mm;
+	connector->display_info.height_mm = n3_mode.height_mm;
+	connector->display_info.bpc = 10;
+	return 1;
+}
+
+static const struct drm_panel_funcs n3_panel_funcs = {
+	.prepare = n3_prepare,
+	.disable = n3_disable,
+	.unprepare = n3_unprepare,
+	.get_modes = n3_get_modes,
+};
+
+static int n3_bl_update_status(struct backlight_device *bl)
+{
+	struct xiaomi_n3 *ctx = bl_get_data(bl);
+	unsigned long flags;
+	int ret = 0;
+
+	mutex_lock(&ctx->lock);
+	if (ctx->powered) {
+		flags = ctx->dsi->mode_flags;
+		/* Stock backlight transfers use HS and send the high byte first. */
+		ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+		ret = mipi_dsi_dcs_set_display_brightness_large(ctx->dsi,
+						backlight_get_brightness(bl));
+		ctx->dsi->mode_flags = flags;
+	}
+	mutex_unlock(&ctx->lock);
+	return ret;
+}
+
+static const struct backlight_ops n3_bl_ops = {
+	.update_status = n3_bl_update_status,
+};
+
+static int n3_probe(struct mipi_dsi_device *dsi)
+{
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 307, /* Vendor initial brightness; avoid HBM. */
+		.max_brightness = 2047,
+	};
+	struct device *dev = &dsi->dev;
+	struct xiaomi_n3 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct xiaomi_n3, panel,
+				   &n3_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+	ctx->dsi = dsi;
+	mutex_init(&ctx->lock);
+	ctx->supplies[0].supply = "vddio";
+	ctx->supplies[1].supply = "vci";
+	ctx->supplies[2].supply = "vddd";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get panel supplies\n");
+	ctx->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset), "Failed to get reset GPIO\n");
+
+	mipi_dsi_set_drvdata(dsi, ctx);
+	dsi->lanes = 4;
+	/* Match the 10-bpc DSC stream and the stock 30-bpp DSI interface. */
+	dsi->format = MIPI_DSI_FMT_RGB101010;
+	dsi->mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS;
+	ctx->panel.prepare_prev_first = true; /* Vendor lp11-init requirement. */
+
+	/* The embedded vendor 0x70 PPS is DSC 1.1, despite its DT's 1.2 label.
+	 * Use the same RGB pre-SCR encoding that the MSM driver supports.
+	 */
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_height = 30;
+	ctx->dsc.slice_width = 600;
+	ctx->dsc.slice_count = 2;
+	ctx->dsc.bits_per_component = 10;
+	ctx->dsc.bits_per_pixel = 8 << 4;
+	ctx->dsc.block_pred_enable = true;
+	dsi->dsc = &ctx->dsc;
+
+	ctx->panel.backlight = devm_backlight_device_register(dev, "houji-n3",
+					dev, ctx, &n3_bl_ops, &props);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to register backlight\n");
+
+	drm_panel_add(&ctx->panel);
+	ret = devm_mipi_dsi_attach(dev, dsi);
+	if (ret) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach DSI\n");
+	}
+	return 0;
+}
+
+static void n3_remove(struct mipi_dsi_device *dsi)
+{
+	struct xiaomi_n3 *ctx = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id n3_of_match[] = {
+	{ .compatible = "xiaomi,n3-42-0d-0a" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, n3_of_match);
+
+static struct mipi_dsi_driver n3_driver = {
+	.probe = n3_probe,
+	.remove = n3_remove,
+	.driver = {
+		.name = "panel-xiaomi-n3",
+		.of_match_table = n3_of_match,
+	},
+};
+module_mipi_dsi_driver(n3_driver);
+
+MODULE_DESCRIPTION("Xiaomi 14 N3 AMOLED panel, experimental 120 Hz support");
+MODULE_LICENSE("GPL");
