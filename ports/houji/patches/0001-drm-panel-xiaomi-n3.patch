From: Armada Houji bring-up
Subject: [PATCH] drm/panel: add experimental Xiaomi 14 N3 command panel

Use the pinned downstream N3 120 Hz sequence with Linux DRM power and DSC
handling. Kept local to the Houji build until hardware validation.

---
diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -1478,4 +1478,12 @@
 	  XPP055C272 controller for 720x1280 LCD panels with MIPI/RGB/SPI
 	  system interfaces.
 
+config DRM_PANEL_XIAOMI_N3
+	tristate "Xiaomi 14 N3 AMOLED panel (experimental)"
+	depends on OF && DRM_MIPI_DSI && BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_DSC_HELPER
+	help
+	  Fixed 1200x2670 at 120 Hz support for the N3 42-0d-0a panel
+	  used in Xiaomi 14 (houji). Not yet tested on hardware.
+
 endmenu
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -143,3 +143,4 @@
 obj-$(CONFIG_DRM_PANEL_AYANEO_WT0600_2K) += panel-wt0600-2k.o
 obj-$(CONFIG_DRM_PANEL_AYANEO_WT0600_1K) += panel-wt0600-1k.o
 obj-$(CONFIG_DRM_PANEL_XINPENG_XPP055C272) += panel-xinpeng-xpp055c272.o
+obj-$(CONFIG_DRM_PANEL_XIAOMI_N3) += panel-xiaomi-n3.o
diff --git a/drivers/gpu/drm/panel/panel-xiaomi-n3.c b/drivers/gpu/drm/panel/panel-xiaomi-n3.c
new file mode 100644
--- /dev/null
