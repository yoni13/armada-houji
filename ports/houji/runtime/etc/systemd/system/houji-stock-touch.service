[Unit]
Description=Houji continuous stock touch
StartLimitIntervalSec=0
After=systemd-udevd.service houji-sensors.service
Wants=houji-sensors.service
Before=display-manager.service
[Service]
Type=exec
ExecStartPre=/bin/sh -c "for i in $(seq 1 30); do test ! -e /dev/fastrpc-adsp || break; sleep 1; done"
ExecStartPre=/usr/sbin/modprobe houji-tcm-probe
Restart=on-failure
RestartSec=1
TimeoutStopSec=2
ExecStart=/usr/libexec/armada/houji-stock-core /usr/lib/armada/houji/touch/libtouchreport.so /usr/lib/armada/houji/touch/houji_syna_thp_config.ini --continuous /dev/houji-touch-raw --uinput
