#!/usr/bin/python3
"""Expose the physical X2s in Plasma; retain its Deck mapping in Game Mode."""
import os
from pathlib import Path
import pwd
import signal
import subprocess
import threading

SOURCE = Path('/usr/share/inputplumber/devices/11-gamesir-x2s.yaml')
OVERRIDE = Path('/etc/inputplumber/devices.d/10-houji-x2s-session.yaml')
HEADER = '# Generated by houji-x2s-session; session-specific X2s routing.\n'


def session_mode(uid, proc=Path('/proc')):
    """A per-game nested Gamescope in Plasma must not select Game Mode."""
    game = False
    for path in proc.iterdir():
        if not path.name.isdecimal():
            continue
        try:
            if path.stat().st_uid != uid:
                continue
            # Compositors rename their main thread: Gamescope becomes
            # gamescope-wl once running. /proc/comm is not executable identity.
            executable = (path / 'exe').resolve(strict=True).name
            if executable == 'kwin_wayland':
                return 'desktop'
            if executable == 'gamescope':
                args = (path / 'cmdline').read_bytes().split(b'\0')
                if b'--steam' in args:
                    game = True
        except OSError:
            continue
    return 'game' if game else None


def profile(mode):
    text = SOURCE.read_text()
    if mode == 'desktop':
        # Ignore only the physical gamepad. Keep consuming the separate record
        # report (Power + VolumeDown) so it cannot suspend the desktop. Its Guide
        # mapping has no gamepad target here; VolumeUp still passes to keyboard.
        anchor = '  - group: gamepad\n'
        targets = 'target_devices:\n  - deck-uhid\n  - keyboard\n'
        if text.count(anchor) != 1 or text.count(targets) != 1:
            raise RuntimeError('Unexpected X2s profile layout')
        text = text.replace(anchor, anchor + '    ignore: true\n')
        text = text.replace(targets, 'target_devices:\n  - keyboard\n')
    elif mode != 'game':
        raise ValueError('Unknown session mode')
    return HEADER + text


def write_profile(text):
    OVERRIDE.parent.mkdir(parents=True, exist_ok=True)
    if OVERRIDE.exists():
        previous = OVERRIDE.read_text()
        if not previous.startswith(HEADER):
            raise RuntimeError('X2s override already contains a custom configuration')
        if previous == text:
            return
    temporary = OVERRIDE.with_suffix('.tmp')
    temporary.write_text(text)
    temporary.chmod(0o644)
    temporary.replace(OVERRIDE)


def run(*args):
    return subprocess.run(args, check=True, capture_output=True, text=True, timeout=10).stdout


def apply(mode):
    # Publish before restarting: discovery and future hotplug see this routing.
    write_profile(profile(mode))
    # This InputPlumber version discovers evdev through devnode creation, not
    # udev add events, and CreateCompositeDevice is a stub. Reload once at the
    # session boundary so existing devices are rediscovered with the new config.
    run('systemctl', 'restart', 'inputplumber.service')


def main():
    uid = pwd.getpwnam('armada').pw_uid
    stop = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    signal.signal(signal.SIGINT, lambda *_: stop.set())
    applied = None
    failed = False
    while not stop.is_set():
        mode = session_mode(uid)
        if mode and mode != applied:
            try:
                apply(mode)
                applied, failed = mode, False
                print('X2s routing: ' + ('physical gamepad in Plasma' if mode == 'desktop'
                                        else 'Steam Deck mapping in Game Mode'), flush=True)
            except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
                if not failed:
                    print('X2s routing unavailable; will retry', flush=True)
                failed = True
        stop.wait(5 if failed else 1)


if __name__ == '__main__':
    if os.geteuid():
        raise SystemExit('X2s session routing must run as root')
    main()
