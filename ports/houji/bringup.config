# Houji stock-ABL internal installation; modules are built with this kernel.
CONFIG_LOCALVERSION="-armada-houji"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_USB_HID=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_GUNYAH_WATCHDOG=y
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_QCOM_SPMI_ADC5_GEN3=y

# Native DSI display and Adreno GPU.
CONFIG_DRM_PANEL_XIAOMI_N3=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_KMS=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_SM_DISPCC_8550=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_MSM_KMS_FBDEV=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y

# WCN7850 / Kiwi v2 on PCIe0. NetworkManager manages connections in userspace.
CONFIG_PCI=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PCI_PWRCTRL=y
CONFIG_PCI_PWRCTRL_PWRSEQ=y
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH12K=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QRTR=y
CONFIG_QRTR_MHI=y
CONFIG_MHI_BUS=y
CONFIG_FW_LOADER=y

# Root filesystems and device support needed by the complete installation.
CONFIG_EXT4_FS=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_INPUT_UINPUT=y
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_FASTRPC=y
CONFIG_BATTERY_QCOM_BATTMGR=m
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_INPUT_QCOM_HV_HAPTICS=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_SND_SOC_SC8280XP=m
CONFIG_SND_SOC_CS35L41_I2C=m
CONFIG_SND_SOC_WCD939X_SDW=m
CONFIG_USB_VIDEO_CLASS=m
CONFIG_OF_OVERLAY=y
