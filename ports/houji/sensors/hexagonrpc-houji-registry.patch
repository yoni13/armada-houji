+
+/* Resolve through the VFS before allowing a rename in writable registry mappings. */
+int hexagonfs_rename(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+                     const char *old_name, const char *new_name)
+{
+    char *paths[2] = {strdup(old_name), strdup(new_name)};
+    char *leaves[2];
+    int parents[2] = {-1, -1}, ret = -ENOMEM;
+    if (!paths[0] || !paths[1]) goto out;
+    for (int i = 0; i < 2; i++) {
+        /* Registry renames use absolute paths with at least one parent.
+         * Disallow dot segments so an existing VFS descriptor is never aliased. */
+        if (paths[i][0] != '/') { ret = -EINVAL; goto out; }
+        for (const char *part = paths[i] + 1; *part;) {
+            size_t len = strcspn(part, "/");
+            if (!len || (len == 1 && part[0] == '.') ||
+                (len == 2 && part[0] == '.' && part[1] == '.')) {
+                ret = -EINVAL; goto out;
+            }
+            part += len;
+            if (*part) part++;
+        }
+        char *slash = strrchr(paths[i], '/');
+        if (!slash || slash == paths[i]) { ret = -EINVAL; goto out; }
+        *slash = 0; leaves[i] = slash + 1;
+        if (!*leaves[i] || !strcmp(leaves[i], ".") || !strcmp(leaves[i], "..")) {
+            ret = -EINVAL; goto out;
+        }
+        parents[i] = hexagonfs_openat(fds, rootfd, dirfd, paths[i]);
+        if (parents[i] < 0) { ret = parents[i]; goto out; }
+    }
+    struct hexagonfs_fd *a = fds[parents[0]], *b = fds[parents[1]];
+    ret = a->ops->rename ? a->ops->rename(a, leaves[0], b, leaves[1]) : -EROFS;
+out:
+    for (int i = 0; i < 2; i++) {
+        if (parents[i] >= 0) hexagonfs_close(fds, parents[i]);
+        free(paths[i]);
+    }
+    return ret;
+}
