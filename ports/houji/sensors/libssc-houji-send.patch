+/*****************************************************************************/
+
+static void
+sensor_send_ready (SSCClient *client, GAsyncResult *result, gpointer user_data)
+{
+	GTask *task = G_TASK (user_data);
+	GError *error = NULL;
+
+	if (!ssc_client_send_finish (client, result, &error))
+		g_task_return_error (task, error);
+	else
+		g_task_return_boolean (task, TRUE);
+	g_object_unref (task);
+}
+
+/*
+ * Send a sensor specific request to this sensor, for example a vendor
+ * configuration message. The payload is the encoded request body.
+ */
+void
+ssc_sensor_send (SSCSensor *self, guint32 message_id, GBytes *payload, GCancellable *cancellable, GAsyncReadyCallback callback, gpointer user_data)
+{
+	SSCSensorPrivate *priv = ssc_sensor_get_instance_private (self);
+	GTask *task = g_task_new (self, cancellable, callback, user_data);
+	g_autoptr (GArray) buf = NULL;
+	gsize len = 0;
+	const guint8 *data = payload ? g_bytes_get_data (payload, &len) : NULL;
+
+	if (len) {
+		buf = g_array_sized_new (FALSE, FALSE, 1, len);
+		g_array_append_vals (buf, data, len);
+	}
+
+	ssc_client_send (priv->client,
+			 priv->uid_high,
+			 priv->uid_low,
+			 message_id,
+			 buf,
+			 cancellable,
+			 (GAsyncReadyCallback)sensor_send_ready,
+			 task);
+}
+
+gboolean
+ssc_sensor_send_finish (SSCSensor *self, GAsyncResult *result, GError **error)
+{
+	return g_task_propagate_boolean (G_TASK (result), error);
+}
+
+/*****************************************************************************/
+
