// Only the installed system service may claim sensors outside a login session.
polkit.addRule(function(action, subject) {
    if (action.id == "net.hadess.SensorProxy.claim-sensor" &&
        subject.user == "armada" &&
        subject.system_unit == "houji-gamescope-orientation.service" &&
        subject.no_new_privileges) {
        return polkit.Result.YES;
    }
});
