#!/usr/bin/python3
"""Publish UPower telemetry through Steam's native vpower reader.

Steam's SDL fallback provides no charging estimate. No charging controls are
written here. Unknown runtime must be -1: vpower interprets zero as a request
to shut down the machine, even when the battery is charging.
"""
import math
import os
from pathlib import Path
import signal
import socket
import sys
import time


def values(properties, on_battery):
    percent = float(properties['Percentage'])
    if not properties['IsPresent'] or not math.isfinite(percent) or not 0 <= percent <= 100:
        raise ValueError('Battery percentage unavailable')
    state = int(properties['State'])
    full = int(properties['TimeToFull'])
    empty = int(properties['TimeToEmpty'])
    status = {1: 'Charging', 2: 'Discharging', 3: 'Discharging',
              4: 'Full', 5: 'Not charging', 6: 'Discharging'}.get(state, 'Unknown')
    return {
        'ac_status': 'Disconnected' if on_battery else 'Connected',
        'battery_status': status,
        'secs_until_battery_full': str(full if state == 1 and full > 0 else -1),
        # UPower remains responsible for critical-battery policy. In
        # particular, its TimeToEmpty=0 while charging is NOT a shutdown.
        'secs_until_shutdown_request': str(empty if state in (2, 6) and empty > 0 else -1),
        'battery_percent': f'{percent:g}',
    }


def publish(directory, readings):
    # Publish the discovery file last, so Steam never discovers a partial
    # initial snapshot. Each individual file replacement is atomic.
    for name, value in readings.items():
        path = directory / name
        content = value + '\n'
        if path.exists() and path.read_text() == content:
            continue
        temp = directory / ('.' + name + '.tmp')
        temp.write_text(content)
        temp.chmod(0o644)
        temp.replace(path)


def notify_ready():
    address = os.environ.get('NOTIFY_SOCKET')
    if not address:
        return
    if address.startswith('@'):
        address = '\0' + address[1:]
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as client:
        client.connect(address)
        client.sendall(b'READY=1')


def main():
    import gi
    gi.require_version('Gio', '2.0')
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    directory = Path('/run/vpower')
    directory.mkdir(mode=0o755, exist_ok=True)
    marker = directory / '.houji-upower'
    if not marker.exists() and any(directory.iterdir()):
        raise RuntimeError('/run/vpower is already supplied by another provider')
    marker.touch(mode=0o644)
    ready = False
    error_message = None
    stopped = False

    def stop(_signum, _frame):
        nonlocal stopped
        stopped = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    while not stopped:
        try:
            properties = bus.call_sync('org.freedesktop.UPower',
                '/org/freedesktop/UPower/devices/DisplayDevice',
                'org.freedesktop.DBus.Properties', 'GetAll',
                GLib.Variant('(s)', ('org.freedesktop.UPower.Device',)),
                None, Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]
            on_battery = bus.call_sync('org.freedesktop.UPower',
                '/org/freedesktop/UPower', 'org.freedesktop.DBus.Properties', 'Get',
                GLib.Variant('(ss)', ('org.freedesktop.UPower', 'OnBattery')),
                None, Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]
            publish(directory, values(properties, on_battery))
            if not ready:
                notify_ready()
                ready = True
            error_message = None
        except (GLib.Error, OSError, ValueError, KeyError) as exc:
            # Clear stale estimates during telemetry loss, without inventing
            # a new percentage or ever requesting a shutdown.
            if ready:
                publish(directory, {'battery_status': 'Unknown',
                    'secs_until_battery_full': '-1',
                    'secs_until_shutdown_request': '-1'})
            if str(exc) != error_message:
                print(f'UPower telemetry unavailable: {exc}', file=sys.stderr, flush=True)
                error_message = str(exc)
        time.sleep(2)


if __name__ == '__main__':
    main()
