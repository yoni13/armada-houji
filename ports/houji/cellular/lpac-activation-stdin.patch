diff --git a/src/applet/profile/download.c b/src/applet/profile/download.c
--- a/src/applet/profile/download.c
+++ b/src/applet/profile/download.c
@@ -101,6 +101,19 @@ static int applet_main(int argc, char **argv) {
             break;
         case 'a':
             activation_code = strdup(optarg);
+            /* Keep activation codes out of process arguments and journals. */
+            if (strcmp(optarg, "-") == 0) {
+                char input[4096];
+                if (!fgets(input, sizeof(input), stdin) ||
+                    !strchr(input, '\n')) {
+                    free(activation_code);
+                    return -1;
+                }
+                input[strcspn(input, "\r\n")] = '\0';
+                free(activation_code);
+                activation_code = strdup(input);
+                memset(input, 0, sizeof(input));
+            }
             if (strncmp(activation_code, "LPA:", 4) == 0) {
                 activation_code += 4; // ignore uri scheme
             }
