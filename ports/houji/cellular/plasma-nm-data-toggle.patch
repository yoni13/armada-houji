+QCoro::Task<void> CellularModem::applyMobileDataEnabled()
+{
+    m_dataChangeRunning = true;
+    Q_EMIT mobileDataEnabledChanged();
+    QPointer<CellularModem> guard(this);
+    bool enabled;
+    do {
+        enabled = m_requestedDataEnabled;
+        const auto modem = m_nmModem;
+        if (!modem) {
+            break;
+        }
+        if (enabled && !NetworkManager::isWwanEnabled()) {
+            NetworkManager::setWwanEnabled(true);
+        }
+        // Block autoactivation while settings are saved, then perform the
+        // requested operation. Never race a pending disconnect with activation.
+        modem->setAutoconnect(false);
+        const auto connections = modem->availableConnections();
+        NetworkManager::Connection::Ptr latest;
+        for (const auto &con : connections) {
+            if (!latest || con->settings()->timestamp() > latest->settings()->timestamp()) {
+                latest = con;
             }
         }
-
-        // if we found the last used connection, set it to autoconnect and connect it immediately
-        if (!latestCon.isNull()) {
-            latestCon->settings()->setAutoconnect(true);
-            latestCon->update(latestCon->settings()->toMap());
-            NetworkManager::activateConnection(latestCon->path(), m_nmModem->uni(), QString());
+        bool failed = false;
+        for (const auto &con : connections) {
+            auto settings = con->settings();
+            settings->setAutoconnect(enabled && con == latest);
+            QDBusReply<void> reply = co_await con->update(settings->toMap());
+            if (!guard) {
+                co_return;
+            }
+            if (!reply.isValid()) {
+                addError(i18n("Could not update mobile data: %1", reply.error().message()));
+                failed = true;
+                break;
+            }
         }
-
-    } else {
-        // disable mobile data...
-
-        // we do not call NetworkManager::setWwanEnabled(false), because it turns off cellular
-        m_nmModem->setAutoconnect(false);
-        // we need to also set all connections to not autoconnect (#182)
-        for (NetworkManager::Connection::Ptr con : m_nmModem->availableConnections()) {
-            con->settings()->setAutoconnect(false);
-            con->update(con->settings()->toMap());
+        if (failed) {
+            break;
         }
-        // disconnect network
-        m_nmModem->disconnectInterface();
-    }
+        if (enabled) {
+            if (latest) {
+                QDBusReply<QDBusObjectPath> reply = co_await NetworkManager::activateConnection(latest->path(), modem->uni(), QString());
+                if (!guard) {
+                    co_return;
+                }
+                if (!reply.isValid()) {
+                    addError(i18n("Could not enable mobile data: %1", reply.error().message()));
+                }
+            }
+            modem->setAutoconnect(true);
+        } else {
+            QDBusReply<void> reply = co_await modem->disconnectInterface();
+            if (!guard) {
+                co_return;
+            }
+            if (!reply.isValid()) {
+                addError(i18n("Could not disable mobile data: %1", reply.error().message()));
+            }
+        }
+    } while (enabled != m_requestedDataEnabled);
+    m_dataChangeRunning = false;
+    refreshProfiles();
+    Q_EMIT mobileDataEnabledChanged();
 }
 
 bool CellularModem::hasSim() const
@@ -323,6 +356,8 @@ void CellularModem::refreshSims()
     Q_EMIT simsChanged();
