 {
+    if (m_nmModem) {
+        disconnect(m_nmModem.data(), nullptr, this, nullptr);
+    }
     m_nmModem = nullptr;
 
     for (NetworkManager::Device::Ptr nmDevice : NetworkManager::networkInterfaces()) {
@@ -99,9 +103,9 @@ void CellularModem::findNetworkManagerDevice()
             Q_EMIT activeConnectionUniChanged();
         });
 
-        m_profiles->setNmModem(m_nmModem);
-        refreshProfiles();
     }
+    m_profiles->setNmModem(m_nmModem);
+    refreshProfiles();
 
     Q_EMIT nmModemChanged();
     Q_EMIT mobileDataEnabledChanged();
@@ -161,6 +165,9 @@ bool CellularModem::needsAPNAdded() const
 
