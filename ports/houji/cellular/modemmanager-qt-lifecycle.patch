From: Armada contributors
Subject: [PATCH] publish modem and SIM removals after updating the cached state

Signal handlers can synchronously rebuild their modem/SIM lists. Publishing
removal before erasing the cached object leaves Plasma retaining a removed
modem after suspend. Also watch SIM path changes when no SIM exists initially,
and never create a SIM object for the D-Bus null path.

diff --git a/src/manager.cpp b/src/manager.cpp
--- a/src/manager.cpp
+++ b/src/manager.cpp
@@ -153,8 +153,12 @@ void ModemManager::ModemManagerPrivate::daemonRegistered()
 
 void ModemManager::ModemManagerPrivate::daemonUnregistered()
 {
-    Q_EMIT serviceDisappeared();
+    const auto removed = modemList.keys();
     modemList.clear();
+    for (const auto &uni : removed) {
+        Q_EMIT modemRemoved(uni);
+    }
+    Q_EMIT serviceDisappeared();
 }
 
 void ModemManager::ModemManagerPrivate::onInterfacesAdded(const QDBusObjectPath &object_path, const MMVariantMapMap &interfaces_and_properties)
@@ -200,8 +204,8 @@ void ModemManager::ModemManagerPrivate::onInterfacesRemoved(const QDBusObjectPat
 
     // Remove modem when there is no interface or Modem interfaces has been removed
     if (!uni.isEmpty() && (interfaces.isEmpty() || (modem && modem->interfaces().isEmpty()) || interfaces.contains(QLatin1String(MMQT_DBUS_INTERFACE_MODEM)))) {
-        Q_EMIT modemRemoved(uni);
         modemList.remove(uni);
+        Q_EMIT modemRemoved(uni);
     }
 }
 
